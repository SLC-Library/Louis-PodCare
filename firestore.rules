rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read access to all podcasts, allow write for authenticated or admin operations
    match /podcasts/{podcastId} {
      allow read: if true;
      allow write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
